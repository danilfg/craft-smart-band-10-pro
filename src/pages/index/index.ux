.hud { position:absolute; top:0px; left:0px; width:336px; height:103px; background-color:rgba(11,29,49,.88); padding:8px; flex-direction:column; }
.hud-line { width:320px; height:28px; flex-direction:row; justify-content:space-between; align-items:center; }
