<template>
  <stack class="screen" @swipe="handleSwipe">
    <div if="{{screen === 'menu'}}" class="panel menu">
      <image class="logo" src="/common/logo.png"></image>
      <text class="title">POCKET CRAFT</text>
      <text class="subtitle">LIGHT EDITION • BAND 10 PRO</text>
      <div class="button primary" @click="startSurvival"><text class="button-dark">SURVIVAL</text></div>
      <div class="button blue" @click="startCreative"><text class="button-text">CREATIVE</text></div>
      <div if="{{hasSave}}" class="button green" @click="continueGame"><text class="button-text">CONTINUE</text></div>
      <div class="button muted" @click="openHelp"><text class="button-text">HOW TO PLAY</text></div>
      <div class="button danger" @click="exitGame"><text class="button-text">EXIT GAME</text></div>
      <text if="{{bootError}}" class="error">{{bootError}}</text>
      <text class="footnote">v0.2 • OFFLINE • ENGLISH</text>
    </div>

    <div if="{{screen === 'loading'}}" class="panel loading">
      <text class="title">POCKET CRAFT</text>
      <text class="subtitle">PREPARING WORLD...</text>
      <div class="button muted" @click="toMenu"><text class="button-text">CANCEL</text></div>
      <div class="button danger" @click="exitGame"><text class="button-text">EXIT GAME</text></div>
    </div>

    <!-- Nine fixed image nodes. No 9x9 loop or runtime-generated component tree. -->
    <div if="{{screen === 'play'}}" class="world">
      <div class="ground"></div>
      <image class="voxel" src="{{tile0Src}}" style="left:136px; top:{{tile0Y}}px;"></image>
      <image class="voxel" src="{{tile1Src}}" style="left:98px; top:{{tile1Y}}px;"></image>
      <image class="voxel" src="{{tile2Src}}" style="left:174px; top:{{tile2Y}}px;"></image>
      <image class="voxel" src="{{tile3Src}}" style="left:60px; top:{{tile3Y}}px;"></image>
      <image class="voxel" src="{{tile4Src}}" style="left:136px; top:{{tile4Y}}px;"></image>
      <image class="voxel" src="{{tile5Src}}" style="left:212px; top:{{tile5Y}}px;"></image>
      <image class="voxel" src="{{tile6Src}}" style="left:98px; top:{{tile6Y}}px;"></image>
      <image class="voxel" src="{{tile7Src}}" style="left:174px; top:{{tile7Y}}px;"></image>
      <image class="voxel" src="{{tile8Src}}" style="left:136px; top:{{tile8Y}}px;"></image>
      <image if="{{mobVisible}}" class="mob" src="/common/zombie.png" style="left:{{mobX}}px; top:{{mobY}}px;"></image>
      <image class="player" src="/common/player.png" style="top:{{playerY}}px;"></image>
      <image class="target" src="/common/cursor.png" style="left:{{targetX}}px; top:{{targetY}}px;"></image>
    </div>

    <div if="{{screen === 'play'}}" class="hud">
      <text class="hud-top">{{hpText}}     {{foodText}}     {{dayText}}</text>
      <text class="hud-small">{{coords}}  {{biomeText}}</text>
      <text class="hud-message">{{message}}</text>
      <div class="exit-small" @click="exitGame"><text class="small-white">EXIT</text></div>
    </div>
    <div if="{{screen === 'play'}}" class="hotbar" @click="cycleBlock">
      <text class="hotbar-text">BLOCK: {{selectedName}}  x{{selectedCount}}</text>
      <text class="hotbar-next">NEXT &gt;</text>
    </div>

    <div if="{{screen === 'play'}}" class="dpad">
      <div class="arrow north" @click="north"><text class="arrow-label">UP</text></div>
      <div class="arrow west" @click="west"><text class="arrow-label">LEFT</text></div>
      <div class="arrow east" @click="east"><text class="arrow-label">RIGHT</text></div>
      <div class="arrow south" @click="south"><text class="arrow-label">DOWN</text></div>
    </div>
    <div if="{{screen === 'play'}}" class="actions">
      <div class="game-button brown" @click="dig"><text class="game-label">MINE</text></div>
      <div class="game-button green" @click="build"><text class="game-label">PLACE</text></div>
      <div class="game-button danger" @click="hit"><text class="game-label">HIT</text></div>
      <div class="game-button blue" @click="openBag"><text class="game-label">BAG</text></div>
    </div>
    <div if="{{screen === 'play'}}" class="pause-button" @click="pause"><text class="small-white">PAUSE</text></div>

    <div if="{{screen === 'pause'}}" class="panel overlay">
      <text class="title">PAUSED</text>
      <text class="info">{{coords}}</text>
      <div class="button primary" @click="resume"><text class="button-dark">RESUME</text></div>
      <div class="button blue" @click="openCraft"><text class="button-text">CRAFT</text></div>
      <div class="button muted" @click="saveNow"><text class="button-text">SAVE WORLD</text></div>
      <div class="button muted" @click="toMenu"><text class="button-text">MAIN MENU</text></div>
      <div class="button danger" @click="exitGame"><text class="button-text">EXIT GAME</text></div>
    </div>

    <div if="{{screen === 'bag'}}" class="panel overlay">
      <text class="title">INVENTORY</text>
      <text class="info">SELECTED: {{selectedName}}</text>
      <text class="info">AMOUNT: {{selectedCount}}</text>
      <div class="button blue" @click="cycleBlock"><text class="button-text">NEXT BLOCK</text></div>
      <div class="button green" @click="eatFood"><text class="button-text">EAT FOOD</text></div>
      <div class="button muted" @click="openCraft"><text class="button-text">CRAFT</text></div>
      <div class="button primary" @click="resume"><text class="button-dark">BACK TO GAME</text></div>
      <div class="button danger" @click="exitGame"><text class="button-text">EXIT</text></div>
    </div>

    <div if="{{screen === 'craft'}}" class="panel overlay">
      <text class="title">CRAFTING</text>
      <text class="info">{{recipeTitle}}</text>
      <text class="info">{{recipeCost}}</text>
      <div class="button blue" @click="nextRecipe"><text class="button-text">NEXT RECIPE</text></div>
      <div class="button green" @click="make"><text class="button-text">CRAFT ITEM</text></div>
      <text class="info">{{message}}</text>
      <div class="button primary" @click="resume"><text class="button-dark">BACK TO GAME</text></div>
      <div class="button danger" @click="exitGame"><text class="button-text">EXIT</text></div>
    </div>

    <div if="{{screen === 'help'}}" class="panel overlay">
      <text class="title">HOW TO PLAY</text>
      <text class="help">ARROWS - MOVE</text>
      <text class="help">MINE - DIG FRONT BLOCK</text>
      <text class="help">PLACE - BUILD FRONT BLOCK</text>
      <text class="help">BLOCK - CHANGE MATERIAL</text>
      <text class="help">BAG - FOOD AND CRAFTING</text>
      <text class="help">SWIPE RIGHT - PAUSE</text>
      <div class="button primary" @click="toMenu"><text class="button-dark">MAIN MENU</text></div>
      <div class="button danger" @click="exitGame"><text class="button-text">EXIT GAME</text></div>
    </div>

    <div if="{{screen === 'dead'}}" class="panel overlay">
      <text class="title">GAME OVER</text>
      <text class="info">TRY AGAIN?</text>
      <div class="button primary" @click="respawn"><text class="button-dark">RESPAWN</text></div>
      <div class="button muted" @click="toMenu"><text class="button-text">MAIN MENU</text></div>
      <div class="button danger" @click="exitGame"><text class="button-text">EXIT GAME</text></div>
    </div>
  </stack>
</template>

<script>
import storage from '@system.storage'
import app from '@system.app'

// Same tested dependency-free engine. Embedded to avoid firmware module imports.
// PocketCraft world logic. Deterministic, offline and dependency-free.
const MATERIALS = ['grass','dirt','stone','sand','snow','wood','leaves','coal','iron','water','plank','brick','torch'];
const RECIPES = [
  {id:'plank',title:'4 PLANKS',needs:{wood:1},makes:{plank:4}},
  {id:'pickaxe',title:'STONE PICK',needs:{wood:2,stone:3},makes:{pickaxe:1}},
  {id:'sword',title:'STONE SWORD',needs:{wood:2,stone:2},makes:{sword:1}},
  {id:'bread',title:'BERRY BREAD',needs:{berries:3},makes:{bread:1}},
  {id:'torch',title:'4 TORCHES',needs:{wood:1,coal:1},makes:{torch:4}},
  {id:'brick',title:'4 BRICKS',needs:{stone:4},makes:{brick:4}}
];
const HOTBAR = ['dirt','stone','wood','plank','brick','torch'];
const CHUNK_SIZE = 8;
function hash(x,y,seed) {
  let n = Math.imul(x,374761393) + Math.imul(y,668265263) + Math.imul(seed,1442695041);
  n = Math.imul(n ^ (n >>> 13),1274126177);
  n = n ^ (n >>> 16);
  return (n >>> 0) / 4294967295;
}
function smooth(x,y,seed,scale) {
  const fx=x/scale, fy=y/scale, ix=Math.floor(fx),iy=Math.floor(fy);
  let u=fx-ix,v=fy-iy;u=u*u*(3-2*u);v=v*v*(3-2*v);
  const a=hash(ix,iy,seed),b=hash(ix+1,iy,seed),c=hash(ix,iy+1,seed),d=hash(ix+1,iy+1,seed);
  return (a+(b-a)*u)*(1-v)+(c+(d-c)*u)*v;
}
function terrain(x,y,seed) {
  const climate=smooth(x,y,seed+55,22);
  const moisture=smooth(x,y,seed+89,16);
  const elev=smooth(x,y,seed,9)*0.7+smooth(x,y,seed+2,4)*0.3;
  const biome=climate<0.32?'snow':climate>0.68?'desert':moisture<0.31?'highland':'forest';
  let h=Math.max(1,Math.min(6,Math.floor(elev*6)+1));
  let type=biome==='desert'?'sand':biome==='snow'?'snow':biome==='highland'?'stone':'grass';
  if(h===1 && biome!=='snow')type='water';
  const decoration=hash(x,y,seed+772);
  if (type==='grass' && decoration>0.955)type='wood';
  if (type==='stone' && decoration>0.87)type=hash(x,y,seed+8)>0.58?'iron':'coal';
  if (type==='snow' && decoration>0.98)type='wood';
  return {h,type,biome};
}
function generatedCell(s,x,y) {
  const cx=Math.floor(x/CHUNK_SIZE),cy=Math.floor(y/CHUNK_SIZE);
  const key=cx+','+cy;
  if(!s.chunks)s.chunks={};
  if(!s.chunks[key]) {
    if(Object.keys(s.chunks).length>=4)delete s.chunks[Object.keys(s.chunks)[0]];
    const cells=[];
    for(let ly=0;ly<CHUNK_SIZE;ly++)for(let lx=0;lx<CHUNK_SIZE;lx++)
      cells.push(terrain(cx*CHUNK_SIZE+lx,cy*CHUNK_SIZE+ly,s.seed));
    s.chunks[key]=cells;
  }
  return s.chunks[key][(y-cy*CHUNK_SIZE)*CHUNK_SIZE+(x-cx*CHUNK_SIZE)];
}
function cell(s,x,y) {
  const edit=s.edits[x+','+y],base=generatedCell(s,x,y);
  return edit?{h:edit.h,type:edit.type,biome:base.biome}:base;
}
function createGame(seed,mode) {
  return {
    seed:seed>>>0,mode:mode==='creative'?'creative':'survival',
    x:0,y:0,dir:1,time:24,health:10,hunger:10,
    inv:{dirt:8,stone:5,wood:4,plank:0,brick:0,torch:1,coal:0,iron:0,berries:3,bread:1,pickaxe:0,sword:0},
    edits:{},chunks:{},selected:'dirt',enemies:[],kills:0,steps:0,tickNo:0,message:'Explore your world'
  };
}
function isNight(s) { return (s.time%180)>=104; }
function facing(s) {
  const ds=[[0,-1],[1,0],[0,1],[-1,0]];
  const v=ds[s.dir%4];
  return {x:s.x+v[0],y:s.y+v[1]};
}
function setCell(s,x,y,h,type) {
  const key=x+','+y;
  // Keep save bounded on a low-memory watch; preserve most recently edited places.
  if(!Object.prototype.hasOwnProperty.call(s.edits,key) && Object.keys(s.edits).length>=160) {
    delete s.edits[Object.keys(s.edits)[0]];
  }
  s.edits[key]={h,type};
}
function walk(s,dir) {
  s.dir=dir;
  const dest=facing(s), from=cell(s,s.x,s.y), to=cell(s,dest.x,dest.y);
  if(s.mode!=='creative' && (to.type==='water' || to.h>from.h+1)) {
    s.message=to.type==='water'?'Water: build a bridge':'Too high: mine a step';
    return false;
  }
  s.x=dest.x;s.y=dest.y;s.steps++;
  if(s.mode==='survival' && s.steps%10===0) s.hunger=Math.max(0,s.hunger-1);
  s.message='Biome: '+to.biome.toUpperCase();
  return true;
}
function mine(s) {
  const p=facing(s),t=cell(s,p.x,p.y);
  if(t.type==='water' || t.h<=1) {s.message='Nothing to mine';return false;}
  if((t.type==='iron' || t.type==='coal') && s.mode==='survival' && !s.inv.pickaxe) {
    s.message='Craft a stone pick';return false;
  }
  if(s.mode==='survival') {
    const loot=t.type==='grass'?'dirt':t.type==='snow'?'snow':t.type==='leaves'?'wood':t.type;
    s.inv[loot]=(s.inv[loot]||0)+1;
    if(t.type==='wood' && hash(p.x,p.y,s.seed+9)>0.48)s.inv.berries=(s.inv.berries||0)+1;
  }
  const below=hash(p.x,p.y,s.seed+t.h*37);
  const next=t.h<=2?'stone':below>.89?'coal':below>.83?'iron':t.h>=4?'dirt':'stone';
  setCell(s,p.x,p.y,t.h-1,next);
  s.message='Mined '+t.type.toUpperCase();
  return true;
}
function place(s,type) {
  if(MATERIALS.indexOf(type)<0 || type==='water' || type==='grass' || type==='snow' || type==='coal' || type==='iron') {
    s.message='Choose a build block';return false;
  }
  if(s.mode==='survival' && !(s.inv[type]>0)){s.message='No '+type+' in bag';return false;}
  const p=facing(s),t=cell(s,p.x,p.y);
  if(t.h>=8){s.message='Height limit reached';return false;}
  if(s.mode==='survival')s.inv[type]--;
  setCell(s,p.x,p.y,t.h+1,type);
  s.message='Placed '+type.toUpperCase();
  return true;
}
function craft(s,id) {
  const recipe=RECIPES.find(r=>r.id===id);
  if(!recipe){s.message='Unknown recipe';return false;}
  if(s.mode==='survival') {
    for(const k of Object.keys(recipe.needs))if((s.inv[k]||0)<recipe.needs[k]) {
      s.message='Need '+k.toUpperCase();return false;
    }
    for(const k of Object.keys(recipe.needs))s.inv[k]-=recipe.needs[k];
  }
  for(const k of Object.keys(recipe.makes))s.inv[k]=(s.inv[k]||0)+recipe.makes[k];
  s.message='Crafted '+recipe.title;
  return true;
}
function eat(s) {
  if(s.mode==='creative'){s.message='Creative: always full';return true;}
  const kind=s.inv.bread>0?'bread':s.inv.berries>0?'berries':null;
  if(!kind){s.message='Need food';return false;}
  s.inv[kind]--;s.hunger=Math.min(10,s.hunger+(kind==='bread'?6:2));
  s.health=Math.min(10,s.health+1);s.message='Yum!';return true;
}
function attack(s) {
  const p=facing(s);
  let best=-1,dist=3;
  s.enemies.forEach((m,i)=>{const d=Math.abs(p.x-m.x)+Math.abs(p.y-m.y);if(d<dist){dist=d;best=i;}});
  if(best<0){s.message='No mob nearby';return false;}
  s.enemies.splice(best,1);s.kills++;
  if(s.mode==='survival')s.inv.berries=(s.inv.berries||0)+1;
  s.message='Mob defeated!';return true;
}
function stepTime(s) {
  s.tickNo++;s.time=(s.time+1)%180;
  if(s.mode==='creative')return;
  if(s.tickNo%25===0) {
    if(s.hunger===0)s.health=Math.max(0,s.health-1);
    else if(s.health<10 && s.hunger>7)s.health++;
  }
  if(isNight(s) && s.tickNo%13===0 && s.enemies.length<3) {
    const dx=(hash(s.tickNo,7,s.seed)>0.5?1:-1)*3;
    const dy=(hash(s.tickNo,9,s.seed)>0.5?1:-1)*2;
    s.enemies.push({x:s.x+dx,y:s.y+dy});
  }
  if(s.tickNo%4===0) {
    s.enemies.forEach(m=>{
      if(m.x!==s.x)m.x+=m.x>s.x?-1:1;
      else if(m.y!==s.y)m.y+=m.y>s.y?-1:1;
      if(Math.abs(m.x-s.x)+Math.abs(m.y-s.y)<=1)
        s.health=Math.max(0,s.health-1);
    });
  }
  if(!isNight(s))s.enemies=[];
  if(s.health===0)s.message='You fell! Respawn to continue';
}
function snapshot(s) {
  return JSON.stringify({seed:s.seed,mode:s.mode,x:s.x,y:s.y,dir:s.dir,time:s.time,health:s.health,hunger:s.hunger,inv:s.inv,edits:s.edits,selected:s.selected,kills:s.kills,steps:s.steps});
}
function restore(raw) {
  const v=JSON.parse(raw);
  if(!v || !Number.isFinite(v.seed) || !v.inv || !v.edits)throw Error('Bad save');
  const s=createGame(v.seed,v.mode);
  for(const k of ['x','y','dir','time','health','hunger','selected','kills','steps']) {
    if(v[k]!==undefined)s[k]=v[k];
  }
  s.inv=v.inv;s.edits=v.edits;return s;
}
// Limit the watch to 25 image nodes per scene instead of 81. Rendering
// the old 9x9 world on the low-memory Band 10 Pro could blank the screen.
// Fixed 3x3 visibility window: at most nine voxel textures decoded on watch.
// The full procedural world remains infinite; only the nearby cells are drawn.
function renderTiles(s) {
  const out=[];
  const radius=1;
  for(let layer=-2;layer<=2;layer++) {
    for(let dx=-1;dx<=1;dx++) {
      const dy=layer-dx;
      if(dy < -1 || dy > 1)continue;
      const c=cell(s,s.x+dx,s.y+dy);
      out.push({
        image:'/common/blocks/'+c.type+'_'+c.h+'.png',
        x:Math.round(168+(dx-dy)*38-32),
        y:Math.round(145+(dx+dy)*18-c.h*9),
        h:33+c.h*9
      });
    }
  }
  const center=cell(s,s.x,s.y),front=facing(s);
  const fx=front.x-s.x, fy=front.y-s.y;
  const mobs=s.enemies.filter(m=>Math.abs(m.x-s.x)<=1&&Math.abs(m.y-s.y)<=1);
  const mob=mobs.length?mobs[0]:null;
  return {
    blocks:out, biome:center.biome,
    playerY:Math.round(133-center.h*9),
    targetX:Math.round(168+(fx-fy)*38-24),
    targetY:Math.round(154+(fx+fy)*18-cell(s,front.x,front.y).h*9),
    mobVisible:!!mob,
    mobX:mob?Math.round(168+((mob.x-s.x)-(mob.y-s.y))*38-17):0,
    mobY:mob?Math.round(133+((mob.x-s.x)+(mob.y-s.y))*18-cell(s,mob.x,mob.y).h*9):0
  };
}

const SAVE_KEY='pocketcraft_save_v1'
const TICK_MS=1800

export default {
  private:{
    screen:'menu',hasSave:false,bootError:'',
    hpText:'HP 10',foodText:'FOOD 10',dayText:'DAY',
    coords:'X 0 Y 0',biomeText:'FOREST',message:'Explore',
    selectedName:'DIRT',selectedCount:'8',
    recipeTitle:'4 PLANKS',recipeCost:'1 WOOD',
    playerY:88,targetX:144,targetY:108,
    mobVisible:false,mobX:0,mobY:0,
    tile0Src:'/common/blocks/grass_3.png',tile0Y:80,
    tile1Src:'/common/blocks/grass_3.png',tile1Y:80,
    tile2Src:'/common/blocks/grass_3.png',tile2Y:80,
    tile3Src:'/common/blocks/grass_3.png',tile3Y:80,
    tile4Src:'/common/blocks/grass_3.png',tile4Y:80,
    tile5Src:'/common/blocks/grass_3.png',tile5Y:80,
    tile6Src:'/common/blocks/grass_3.png',tile6Y:80,
    tile7Src:'/common/blocks/grass_3.png',tile7Y:80,
    tile8Src:'/common/blocks/grass_3.png',tile8Y:80,
  },
  onInit(){
    this._game=null
    this._cachedSave=null
    this._timer=null
    this._loadingTimer=null
    this._actions=0
    this._recipeIndex=0
    try{
      storage.get({key:SAVE_KEY,
        success:(res)=>{
          if(!res||!res.data)return
          try{
            const saved=restore(res.data)
            if(saved.seed>=0){this._cachedSave=res.data;this.hasSave=true}
          }catch(e){this._cachedSave=null}
        },
        fail:()=>{}
      })
    }catch(e){}
  },
  onHide(){if(this.screen==='play')this.pause();else this.stopClock()},
  onDestroy(){this.stopClock()},
  onBackPress(){
    if(this.screen==='play')this.pause()
    else if(this.screen==='menu')this.exitGame()
    else if(this.screen==='loading'||this.screen==='help'||this.screen==='dead')this.toMenu()
    else if(this.screen==='bag'||this.screen==='craft')this.pause()
    else this.toMenu()
    return true
  },
  handleSwipe(e){
    if(!e)return
    if(e.direction==='right'){this.onBackPress();return}
    if(this.screen==='play'&&e.direction==='up')this.north()
    if(this.screen==='play'&&e.direction==='down')this.south()
  },
  startSurvival(){this.newWorld('survival')},
  startCreative(){this.newWorld('creative')},
  newWorld(mode){
    this.stopClock()
    this.screen='loading'
    this.bootError=''
    const seed=Date.now()&0x7fffffff
    this._loadingTimer=setTimeout(()=>{
      this._loadingTimer=null
      if(this.screen!=='loading')return
      this.launch(()=>{
        this._game=createGame(seed,mode)
      })
    },80)
  },
  continueGame(){
    if(!this._cachedSave)return
    this.stopClock()
    this.screen='loading'
    this._loadingTimer=setTimeout(()=>{
      this._loadingTimer=null
      if(this.screen!=='loading')return
      this.launch(()=>{
        this._game=restore(this._cachedSave)
      })
    },80)
  },
  launch(init){
    try{
      init()
      this.paint()
      this.screen='play'
      this.startClock()
    }catch(e){
      this.stopClock()
      this._game=null
      this.screen='menu'
      this.bootError='WORLD LOAD FAILED'
    }
  },
  paint(){
    const scene=renderTiles(this._game)
    this.tile0Src=scene.blocks[0].image
    this.tile0Y=scene.blocks[0].y
    this.tile1Src=scene.blocks[1].image
    this.tile1Y=scene.blocks[1].y
    this.tile2Src=scene.blocks[2].image
    this.tile2Y=scene.blocks[2].y
    this.tile3Src=scene.blocks[3].image
    this.tile3Y=scene.blocks[3].y
    this.tile4Src=scene.blocks[4].image
    this.tile4Y=scene.blocks[4].y
    this.tile5Src=scene.blocks[5].image
    this.tile5Y=scene.blocks[5].y
    this.tile6Src=scene.blocks[6].image
    this.tile6Y=scene.blocks[6].y
    this.tile7Src=scene.blocks[7].image
    this.tile7Y=scene.blocks[7].y
    this.tile8Src=scene.blocks[8].image
    this.tile8Y=scene.blocks[8].y
    this.playerY=scene.playerY
    this.targetX=scene.targetX
    this.targetY=scene.targetY
    this.mobVisible=scene.mobVisible
    this.mobX=scene.mobX
    this.mobY=scene.mobY
    this.biomeText=scene.biome.toUpperCase()
    this.updateHud()
  },
  updateHud(){
    if(!this._game)return
    const s=this._game
    this.hpText='HP '+s.health
    this.foodText='FOOD '+s.hunger
    this.dayText=isNight(s)?'NIGHT':'DAY'
    this.coords='X '+s.x+'  Y '+s.y
    this.message=s.message
    this.selectedName=s.selected.toUpperCase()
    this.selectedCount=s.mode==='creative'?'MAX':String(s.inv[s.selected]||0)
  },
  startClock(){
    this.stopClock()
    this._timer=setInterval(()=>{
      if(this.screen!=='play'||!this._game)return
      try{
        stepTime(this._game)
        // Only refresh images if mobs change position: once per four ticks.
        if(this._game.tickNo%4===0)this.paint()
        else this.updateHud()
        if(this._game.health<=0){
          this.stopClock()
          this.saveWorld()
          this.screen='dead'
        }else if(this._game.tickNo%20===0)this.saveWorld()
      }catch(e){
        this.stopClock()
        this.screen='pause'
        this.message='GAME PAUSED: RENDER ERROR'
      }
    },TICK_MS)
  },
  stopClock(){
    if(this._loadingTimer){clearTimeout(this._loadingTimer);this._loadingTimer=null}
    if(this._timer){clearInterval(this._timer);this._timer=null}
  },
  markChange(){
    this._actions++
    if(this._actions>=8)this.saveWorld()
  },
  saveWorld(){
    if(!this._game)return
    try{
      const data=snapshot(this._game)
      this._cachedSave=data
      this.hasSave=true
      this._actions=0
      storage.set({key:SAVE_KEY,value:data,fail:()=>{}})
    }catch(e){}
  },
  saveNow(){this.saveWorld();this.message='World saved'},
  move(d){
    if(this.screen!=='play'||!this._game)return
    try{walk(this._game,d);this.paint();this.markChange()}
    catch(e){this.pause();this.message='MOVE ERROR'}
  },
  north(){this.move(0)},
  east(){this.move(1)},
  south(){this.move(2)},
  west(){this.move(3)},
  dig(){this.action(()=>mine(this._game))},
  build(){this.action(()=>place(this._game,this._game.selected))},
  hit(){this.action(()=>attack(this._game))},
  action(fn){
    if(!this._game||this.screen!=='play')return
    try{fn();this.paint();this.markChange()}
    catch(e){this.pause();this.message='ACTION ERROR'}
  },
  cycleBlock(){
    if(!this._game)return
    const idx=HOTBAR.indexOf(this._game.selected)
    this._game.selected=HOTBAR[(idx+1)%HOTBAR.length]
    this.updateHud()
  },
  eatFood(){
    if(!this._game)return
    eat(this._game)
    this.updateHud()
    this.markChange()
  },
  openBag(){if(!this._game)return;this.stopClock();this.screen='bag';this.updateHud()},
  openCraft(){
    if(!this._game)return
    this.stopClock()
    this.screen='craft'
    this.showRecipe()
  },
  showRecipe(){
    const r=RECIPES[this._recipeIndex]
    this.recipeTitle=r.title
    this.recipeCost=Object.keys(r.needs).map(k=>r.needs[k]+' '+k.toUpperCase()).join(' + ')
  },
  nextRecipe(){this._recipeIndex=(this._recipeIndex+1)%RECIPES.length;this.showRecipe()},
  make(){
    if(!this._game)return
    craft(this._game,RECIPES[this._recipeIndex].id)
    this.updateHud()
    this.markChange()
  },
  openHelp(){this.screen='help'},
  pause(){
    this.stopClock()
    if(this._game)this.saveWorld()
    this.screen='pause'
  },
  resume(){
    if(!this._game){this.toMenu();return}
    this.paint()
    this.screen='play'
    this.startClock()
  },
  respawn(){
    if(!this._game){this.toMenu();return}
    const s=this._game
    s.x=0;s.y=0;s.health=10;s.hunger=8;s.time=30;s.enemies=[]
    s.message='New start!'
    this.saveWorld()
    this.resume()
  },
  toMenu(){
    this.stopClock()
    if(this._game)this.saveWorld()
    this.screen='menu'
  },
  exitGame(){
    this.stopClock()
    if(this._game)this.saveWorld()
    app.terminate()
  }
}
</script>

<style>
.screen{width:336px;height:480px;background-color:#102a40;overflow:hidden;}
.panel{position:absolute;left:12px;top:20px;width:312px;height:440px;border:2px solid #72b6a8;border-radius:24px;background-color:#18384f;align-items:center;flex-direction:column;}
.menu{top:15px;height:450px;}
.loading{justify-content:center;}
.logo{width:76px;height:76px;margin-top:11px;}
.title{font-size:28px;font-weight:bold;color:#ffe09a;text-align:center;margin-top:16px;}
.menu .title{margin-top:5px;}
.subtitle{font-size:12px;color:#cae9e6;text-align:center;margin-top:7px;margin-bottom:12px;}
.button{width:260px;height:44px;margin-top:8px;border-radius:13px;align-items:center;justify-content:center;border:2px solid #91b8c5;}
.button-text{font-size:20px;font-weight:bold;color:#ffffff;text-align:center;}
.button-dark{font-size:20px;font-weight:bold;color:#162d42;text-align:center;}
.primary{background-color:#ffd27a;}
.blue{background-color:#365d8d;}
.green{background-color:#35664d;}
.danger{background-color:#823f4a;}
.muted{background-color:#395c70;}
.brown{background-color:#76513d;}
.footnote{font-size:11px;color:#a8c4c7;margin-top:11px;}
.error{font-size:15px;color:#ffb5b5;margin-top:8px;}
.world{position:absolute;top:65px;left:0px;width:336px;height:247px;background-color:#6aabbd;overflow:hidden;}
.ground{position:absolute;top:150px;left:0px;width:336px;height:97px;background-color:#418772;}
.voxel{position:absolute;width:64px;height:105px;}
.player{position:absolute;left:148px;width:44px;height:60px;}
.mob{position:absolute;width:44px;height:60px;}
.target{position:absolute;width:64px;height:40px;}
.hud{position:absolute;top:0px;left:0px;width:336px;height:65px;padding-left:9px;padding-top:4px;background-color:#10283c;}
.hud-top{font-size:16px;font-weight:bold;color:#ffe7ad;}
.hud-small{font-size:13px;color:#cde7e7;margin-top:1px;}
.hud-message{font-size:12px;color:#ffffff;width:240px;margin-top:3px;}
.exit-small{position:absolute;top:26px;right:7px;width:75px;height:33px;border-radius:9px;background-color:#a3424b;align-items:center;justify-content:center;}
.small-white{font-size:15px;font-weight:bold;color:#ffffff;}
.pause-button{position:absolute;top:277px;right:7px;width:77px;height:30px;border-radius:9px;background-color:#3c546a;align-items:center;justify-content:center;}
.hotbar{position:absolute;top:316px;left:11px;width:314px;height:36px;border-radius:9px;background-color:#254963;flex-direction:row;align-items:center;justify-content:space-around;}
.hotbar-text{font-size:16px;color:#ffffff;}
.hotbar-next{font-size:14px;color:#bee1fc;}
.dpad{position:absolute;top:358px;left:6px;width:163px;height:120px;}
.arrow{position:absolute;width:50px;height:38px;border-radius:10px;background-color:#33637c;align-items:center;justify-content:center;}
.arrow-label{font-size:15px;font-weight:bold;color:#ffffff;}
.north{left:57px;top:0px;}
.west{left:0px;top:40px;}
.east{left:112px;top:40px;}
.south{left:57px;top:80px;}
.actions{position:absolute;top:356px;left:174px;width:156px;height:122px;flex-direction:row;flex-wrap:wrap;justify-content:space-around;}
.game-button{width:73px;height:56px;margin-bottom:4px;border-radius:12px;align-items:center;justify-content:center;}
.game-label{font-size:17px;font-weight:bold;color:#ffffff;}
.overlay{top:22px;height:436px;justify-content:center;}
.info{font-size:18px;color:#d8e6ea;margin-top:11px;text-align:center;}
.help{font-size:15px;color:#dce6ed;margin-top:10px;text-align:center;}
</style>
