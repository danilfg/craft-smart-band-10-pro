<template>
  <stack class="screen" @swipe="handleSwipe">
    <image class="sky" src="{{skyImage}}"></image>

    <!-- Depth-sorted visible voxel columns: only top and exterior faces exist in each sprite. -->
    <stack if="{{screen === 'play'}}" class="world">
      <image class="voxel" for="{{blocks}}" tid="id" src="{{$item.image}}" style="left: {{$item.x}}px; top: {{$item.y}}px; height: {{$item.spriteHeight}}px;"></image>
      <image class="target" src="/common/cursor.png" style="left: {{targetX}}px; top: {{targetY}}px;"></image>
      <image class="mob" for="{{mobs}}" tid="id" src="/common/zombie.png" style="left: {{$item.x}}px; top: {{$item.y}}px;"></image>
      <image class="player" src="/common/player.png" style="top: {{playerY}}px;"></image>
    </stack>

    <div if="{{screen === 'play'}}" class="hud">
      <div class="hud-line">
        <text class="hud-hp">♥ {{hp}}/10</text>
        <text class="hud-food">FOOD {{food}}/10</text>
        <text class="hud-day">{{dayText}}</text>
      </div>
      <text class="hud-position">{{coordText}}  •  {{biomeText}}</text>
      <text class="hud-message">{{message}}</text>
      <div class="pause-mini" @click="pause"><text class="pause-label">Ⅱ</text></div>
    </div>

    <div if="{{screen === 'play'}}" class="exit-mini" @click="exitGame"><text class="exit-mini-label">EXIT ✕</text></div>

    <div if="{{screen === 'play'}}" class="hotbar" @click="cycleBlock">
      <text class="hotbar-title">BUILD: {{selectedName}}</text>
      <text class="hotbar-count">{{selectedCount}}  ↻</text>
    </div>

    <div if="{{screen === 'play'}}" class="dpad">
      <div class="dkey up" @click="north"><text class="dkey-text">▲</text></div>
      <div class="dkey left" @click="west"><text class="dkey-text">◀</text></div>
      <div class="dkey right" @click="east"><text class="dkey-text">▶</text></div>
      <div class="dkey down" @click="south"><text class="dkey-text">▼</text></div>
    </div>

    <div if="{{screen === 'play'}}" class="actions">
      <div class="action mine" @click="dig"><text class="action-text">⛏ MINE</text></div>
      <div class="action place" @click="build"><text class="action-text">▣ PLACE</text></div>
      <div class="action fight" @click="hit"><text class="action-text">⚔ HIT</text></div>
      <div class="action bag" @click="openBag"><text class="action-text">BAG</text></div>
    </div>

    <!-- Fully offline menu / survival / creative / save -->
    <div if="{{screen === 'menu'}}" class="panel menu">
      <image class="menu-logo" src="/common/logo.png"></image>
      <text class="title">POCKET CRAFT</text>
      <text class="subtitle">A VOXEL WORLD ON YOUR WRIST</text>
      <div class="btn primary" @click="startSurvival"><text class="btn-label-dark">♥ SURVIVAL</text></div>
      <div class="btn creative" @click="startCreative"><text class="btn-label">✦ CREATIVE</text></div>
      <div if="{{hasSave}}" class="btn continue" @click="continueGame"><text class="btn-label">▶ CONTINUE SAVE</text></div>
      <div class="btn minor" @click="openHelp"><text class="btn-label">HOW TO PLAY</text></div>
      <div class="btn exit" @click="exitGame"><text class="btn-label">✕ EXIT GAME</text></div>
      <text if="{{bootError}}" class="boot-error">{{bootError}}</text>
      <text class="fineprint">OFFLINE • ENGLISH • VELA JS</text>
    </div>

    <div if="{{screen === 'pause'}}" class="panel overlay">
      <text class="panel-title">PAUSED</text>
      <text class="overlay-message">{{coordText}}</text>
      <div class="btn primary" @click="resume"><text class="btn-label-dark">▶ RESUME</text></div>
      <div class="btn creative" @click="openCraft"><text class="btn-label">⚒ CRAFT</text></div>
      <div class="btn minor" @click="saveNow"><text class="btn-label">SAVE WORLD</text></div>
      <div class="btn minor" @click="toMenu"><text class="btn-label">MAIN MENU</text></div>
      <div class="btn exit" @click="exitGame"><text class="btn-label">✕ EXIT GAME</text></div>
    </div>

    <div if="{{screen === 'bag'}}" class="panel list-panel">
      <text class="panel-title small-title">INVENTORY</text>
      <text class="overlay-message">Tap to select build block</text>
      <list class="inventory-list">
        <list-item class="inventory-row" for="{{inventoryRows}}" type="item" @click="selectMaterial($item.id)">
          <text class="inventory-name">{{$item.name}}</text>
          <text class="inventory-count">{{$item.count}}</text>
        </list-item>
      </list>
      <div class="bag-footer">
        <div class="small-btn" @click="eatFood"><text class="small-btn-label">EAT</text></div>
        <div class="small-btn" @click="openCraft"><text class="small-btn-label">CRAFT</text></div>
        <div class="small-btn" @click="resume"><text class="small-btn-label">BACK</text></div>
      </div>
    </div>

    <div if="{{screen === 'craft'}}" class="panel list-panel">
      <text class="panel-title small-title">CRAFTING</text>
      <text class="overlay-message">Tap a recipe to craft</text>
      <list class="recipes-list">
        <list-item class="recipe-row" for="{{recipeRows}}" type="item" @click="make($item.id)">
          <text class="recipe-name">{{$item.title}}</text>
          <text class="recipe-cost">{{$item.cost}}</text>
        </list-item>
      </list>
      <div class="bag-footer">
        <div class="small-btn" @click="openBag"><text class="small-btn-label">BAG</text></div>
        <div class="small-btn" @click="eatFood"><text class="small-btn-label">EAT</text></div>
        <div class="small-btn" @click="resume"><text class="small-btn-label">PLAY ▶</text></div>
      </div>
    </div>

    <div if="{{screen === 'help'}}" class="panel help-panel">
      <text class="panel-title small-title">HOW TO PLAY</text>
      <text class="help-text">ARROWS: WALK AND FACE A BLOCK</text>
      <text class="help-text">MINE: DIG THE YELLOW TARGET</text>
      <text class="help-text">PLACE: BUILD USING YOUR BAG</text>
      <text class="help-text">BAG: CHOOSE BLOCKS, EAT, CRAFT</text>
      <text class="help-text">NIGHT: FIGHT MONSTERS OR HIDE!</text>
      <text class="help-text">CREATIVE: FREE BLOCKS + FLIGHT</text>
      <text class="help-text">SWIPE RIGHT: PAUSE OR BACK</text>
      <text class="help-text">WORLD SAVES AS YOU PLAY.</text>
      <div class="btn primary" @click="toMenu"><text class="btn-label-dark">GOT IT</text></div>
    </div>

    <div if="{{screen === 'dead'}}" class="panel overlay">
      <text class="panel-title">GAME OVER</text>
      <text class="overlay-message">The night was too dangerous.</text>
      <text class="overlay-message">BLOCKS BUILT: {{editsCount}}</text>
      <div class="btn primary" @click="respawn"><text class="btn-label-dark">↻ RESPAWN</text></div>
      <div class="btn minor" @click="toMenu"><text class="btn-label">MAIN MENU</text></div>
      <div class="btn exit" @click="exitGame"><text class="btn-label">✕ EXIT GAME</text></div>
    </div>
  </stack>
</template>

<script>
import storage from '@system.storage'
import app from '@system.app'
// Avoid named module import on older Xiaomi Vela firmware.
// PocketCraft world logic. Deterministic, offline and dependency-free.
const MATERIALS = ['grass','dirt','stone','sand','snow','wood','leaves','coal','iron','water','plank','brick','torch'];
const RECIPES = [
  {id:'plank',title:'4 PLANKS',needs:{wood:1},makes:{plank:4}},
  {id:'pickaxe',title:'STONE PICK',needs:{wood:2,stone:3},makes:{pickaxe:1}},
  {id:'sword',title:'STONE SWORD',needs:{wood:2,stone:2},makes:{sword:1}},
  {id:'bread',title:'BERRY BREAD',needs:{berries:3},makes:{bread:1}},
  {id:'torch',title:'4 TORCHES',needs:{wood:1,coal:1},makes:{torch:4}},
  {id:'brick',title:'4 BRICKS',needs:{stone:4},makes:{brick:4}}
];
const HOTBAR = ['dirt','stone','wood','plank','brick','torch'];
const CHUNK_SIZE = 8;
function hash(x,y,seed) {
  let n = Math.imul(x,374761393) + Math.imul(y,668265263) + Math.imul(seed,1442695041);
  n = Math.imul(n ^ (n >>> 13),1274126177);
  n = n ^ (n >>> 16);
  return (n >>> 0) / 4294967295;
}
function smooth(x,y,seed,scale) {
  const fx=x/scale, fy=y/scale, ix=Math.floor(fx),iy=Math.floor(fy);
  let u=fx-ix,v=fy-iy;u=u*u*(3-2*u);v=v*v*(3-2*v);
  const a=hash(ix,iy,seed),b=hash(ix+1,iy,seed),c=hash(ix,iy+1,seed),d=hash(ix+1,iy+1,seed);
  return (a+(b-a)*u)*(1-v)+(c+(d-c)*u)*v;
}
function terrain(x,y,seed) {
  const climate=smooth(x,y,seed+55,22);
  const moisture=smooth(x,y,seed+89,16);
  const elev=smooth(x,y,seed,9)*0.7+smooth(x,y,seed+2,4)*0.3;
  const biome=climate<0.32?'snow':climate>0.68?'desert':moisture<0.31?'highland':'forest';
  let h=Math.max(1,Math.min(6,Math.floor(elev*6)+1));
  let type=biome==='desert'?'sand':biome==='snow'?'snow':biome==='highland'?'stone':'grass';
  if(h===1 && biome!=='snow')type='water';
  const decoration=hash(x,y,seed+772);
  if (type==='grass' && decoration>0.955)type='wood';
  if (type==='stone' && decoration>0.87)type=hash(x,y,seed+8)>0.58?'iron':'coal';
  if (type==='snow' && decoration>0.98)type='wood';
  return {h,type,biome};
}
function generatedCell(s,x,y) {
  const cx=Math.floor(x/CHUNK_SIZE),cy=Math.floor(y/CHUNK_SIZE);
  const key=cx+','+cy;
  if(!s.chunks)s.chunks={};
  if(!s.chunks[key]) {
    if(Object.keys(s.chunks).length>=4)delete s.chunks[Object.keys(s.chunks)[0]];
    const cells=[];
    for(let ly=0;ly<CHUNK_SIZE;ly++)for(let lx=0;lx<CHUNK_SIZE;lx++)
      cells.push(terrain(cx*CHUNK_SIZE+lx,cy*CHUNK_SIZE+ly,s.seed));
    s.chunks[key]=cells;
  }
  return s.chunks[key][(y-cy*CHUNK_SIZE)*CHUNK_SIZE+(x-cx*CHUNK_SIZE)];
}
function cell(s,x,y) {
  const edit=s.edits[x+','+y],base=generatedCell(s,x,y);
  return edit?{h:edit.h,type:edit.type,biome:base.biome}:base;
}
function createGame(seed,mode) {
  return {
    seed:seed>>>0,mode:mode==='creative'?'creative':'survival',
    x:0,y:0,dir:1,time:24,health:10,hunger:10,
    inv:{dirt:8,stone:5,wood:4,plank:0,brick:0,torch:1,coal:0,iron:0,berries:3,bread:1,pickaxe:0,sword:0},
    edits:{},chunks:{},selected:'dirt',enemies:[],kills:0,steps:0,tickNo:0,message:'Explore your world'
  };
}
function isNight(s) { return (s.time%180)>=104; }
function facing(s) {
  const ds=[[0,-1],[1,0],[0,1],[-1,0]];
  const v=ds[s.dir%4];
  return {x:s.x+v[0],y:s.y+v[1]};
}
function setCell(s,x,y,h,type) {
  const key=x+','+y;
  // Keep save bounded on a low-memory watch; preserve most recently edited places.
  if(!Object.prototype.hasOwnProperty.call(s.edits,key) && Object.keys(s.edits).length>=160) {
    delete s.edits[Object.keys(s.edits)[0]];
  }
  s.edits[key]={h,type};
}
function walk(s,dir) {
  s.dir=dir;
  const dest=facing(s), from=cell(s,s.x,s.y), to=cell(s,dest.x,dest.y);
  if(s.mode!=='creative' && (to.type==='water' || to.h>from.h+1)) {
    s.message=to.type==='water'?'Water: build a bridge':'Too high: mine a step';
    return false;
  }
  s.x=dest.x;s.y=dest.y;s.steps++;
  if(s.mode==='survival' && s.steps%10===0) s.hunger=Math.max(0,s.hunger-1);
  s.message='Biome: '+to.biome.toUpperCase();
  return true;
}
function mine(s) {
  const p=facing(s),t=cell(s,p.x,p.y);
  if(t.type==='water' || t.h<=1) {s.message='Nothing to mine';return false;}
  if((t.type==='iron' || t.type==='coal') && s.mode==='survival' && !s.inv.pickaxe) {
    s.message='Craft a stone pick';return false;
  }
  if(s.mode==='survival') {
    const loot=t.type==='grass'?'dirt':t.type==='snow'?'snow':t.type==='leaves'?'wood':t.type;
    s.inv[loot]=(s.inv[loot]||0)+1;
    if(t.type==='wood' && hash(p.x,p.y,s.seed+9)>0.48)s.inv.berries=(s.inv.berries||0)+1;
  }
  const below=hash(p.x,p.y,s.seed+t.h*37);
  const next=t.h<=2?'stone':below>.89?'coal':below>.83?'iron':t.h>=4?'dirt':'stone';
  setCell(s,p.x,p.y,t.h-1,next);
  s.message='Mined '+t.type.toUpperCase();
  return true;
}
function place(s,type) {
  if(MATERIALS.indexOf(type)<0 || type==='water' || type==='grass' || type==='snow' || type==='coal' || type==='iron') {
    s.message='Choose a build block';return false;
  }
  if(s.mode==='survival' && !(s.inv[type]>0)){s.message='No '+type+' in bag';return false;}
  const p=facing(s),t=cell(s,p.x,p.y);
  if(t.h>=8){s.message='Height limit reached';return false;}
  if(s.mode==='survival')s.inv[type]--;
  setCell(s,p.x,p.y,t.h+1,type);
  s.message='Placed '+type.toUpperCase();
  return true;
}
function craft(s,id) {
  const recipe=RECIPES.find(r=>r.id===id);
  if(!recipe){s.message='Unknown recipe';return false;}
  if(s.mode==='survival') {
    for(const k of Object.keys(recipe.needs))if((s.inv[k]||0)<recipe.needs[k]) {
      s.message='Need '+k.toUpperCase();return false;
    }
    for(const k of Object.keys(recipe.needs))s.inv[k]-=recipe.needs[k];
  }
  for(const k of Object.keys(recipe.makes))s.inv[k]=(s.inv[k]||0)+recipe.makes[k];
  s.message='Crafted '+recipe.title;
  return true;
}
function eat(s) {
  if(s.mode==='creative'){s.message='Creative: always full';return true;}
  const kind=s.inv.bread>0?'bread':s.inv.berries>0?'berries':null;
  if(!kind){s.message='Need food';return false;}
  s.inv[kind]--;s.hunger=Math.min(10,s.hunger+(kind==='bread'?6:2));
  s.health=Math.min(10,s.health+1);s.message='Yum!';return true;
}
function attack(s) {
  const p=facing(s);
  let best=-1,dist=3;
  s.enemies.forEach((m,i)=>{const d=Math.abs(p.x-m.x)+Math.abs(p.y-m.y);if(d<dist){dist=d;best=i;}});
  if(best<0){s.message='No mob nearby';return false;}
  s.enemies.splice(best,1);s.kills++;
  if(s.mode==='survival')s.inv.berries=(s.inv.berries||0)+1;
  s.message='Mob defeated!';return true;
}
function stepTime(s) {
  s.tickNo++;s.time=(s.time+1)%180;
  if(s.mode==='creative')return;
  if(s.tickNo%25===0) {
    if(s.hunger===0)s.health=Math.max(0,s.health-1);
    else if(s.health<10 && s.hunger>7)s.health++;
  }
  if(isNight(s) && s.tickNo%13===0 && s.enemies.length<3) {
    const dx=(hash(s.tickNo,7,s.seed)>0.5?1:-1)*3;
    const dy=(hash(s.tickNo,9,s.seed)>0.5?1:-1)*2;
    s.enemies.push({x:s.x+dx,y:s.y+dy});
  }
  if(s.tickNo%4===0) {
    s.enemies.forEach(m=>{
      if(m.x!==s.x)m.x+=m.x>s.x?-1:1;
      else if(m.y!==s.y)m.y+=m.y>s.y?-1:1;
      if(Math.abs(m.x-s.x)+Math.abs(m.y-s.y)<=1)
        s.health=Math.max(0,s.health-1);
    });
  }
  if(!isNight(s))s.enemies=[];
  if(s.health===0)s.message='You fell! Respawn to continue';
}
function snapshot(s) {
  return JSON.stringify({seed:s.seed,mode:s.mode,x:s.x,y:s.y,dir:s.dir,time:s.time,health:s.health,hunger:s.hunger,inv:s.inv,edits:s.edits,selected:s.selected,kills:s.kills,steps:s.steps});
}
function restore(raw) {
  const v=JSON.parse(raw);
  if(!v || !Number.isFinite(v.seed) || !v.inv || !v.edits)throw Error('Bad save');
  const s=createGame(v.seed,v.mode);
  for(const k of ['x','y','dir','time','health','hunger','selected','kills','steps']) {
    if(v[k]!==undefined)s[k]=v[k];
  }
  s.inv=v.inv;s.edits=v.edits;return s;
}
// Limit the watch to 25 image nodes per scene instead of 81. Rendering
// the old 9x9 world on the low-memory Band 10 Pro could blank the screen.
function renderTiles(s) {
  const out=[],radius=2;
  for(let layer=-radius*2;layer<=radius*2;layer++) {
    for(let dx=-radius;dx<=radius;dx++) {
      const dy=layer-dx;
      if(dy < -radius || dy > radius)continue;
      const c=cell(s,s.x+dx,s.y+dy);
      const px=Math.round(168+(dx-dy)*30-32);
      const py=Math.round(155+(dx+dy)*15-c.h*9);
      out.push({
        id:(dx+radius)*5+(dy+radius),
        image:'/common/blocks/'+c.type+'_'+c.h+'.png',
        x:px,y:py,type:c.type,spriteHeight:33+c.h*9
      });
    }
  }
  const front=facing(s),fx=front.x-s.x,fy=front.y-s.y;
  const center=cell(s,s.x,s.y);
  const mobs=s.enemies.filter(m=>Math.abs(m.x-s.x)<=2&&Math.abs(m.y-s.y)<=2).map((m,i)=>({
    id:i,x:Math.round(168+((m.x-s.x)-(m.y-s.y))*30-17),
    y:Math.round(155+((m.x-s.x)+(m.y-s.y))*15-cell(s,m.x,m.y).h*9-25)
  }));
  return {
    blocks:out,mobs,playerY:Math.round(145-center.h*9),
    targetX:Math.round(168+(fx-fy)*30-21),
    targetY:Math.round(160+(fx+fy)*15-cell(s,front.x,front.y).h*9),
    biome:center.biome
  };
}


const SAVE_KEY = 'pocketcraft_save_v1'
const TICK_MS = 1200

export default {
  private: {
    screen: 'menu', hasSave: false, bootError: '',
    skyImage: '/common/day_bg.png', blocks: [], mobs: [],
    hp: 10, food: 10, dayText: 'DAY', coordText: '0, 0',
    biomeText: 'FOREST', message: 'Welcome', playerY: 110,
    targetX: 160, targetY: 110, selectedName: 'DIRT',
    selectedCount: '8', inventoryRows: [], recipeRows: [], editsCount: 0
  },
  onInit() {
    this._game = null
    this._cachedSave = null
    this._timer = null
    this._lastSaveAt = 0
    try {
      storage.get({
        key: SAVE_KEY,
        success: (res) => {
          if (!res || !res.data) return
          try {
            restore(res.data)
            this._cachedSave = res.data
            this.hasSave = true
          } catch (err) { console.warn('Invalid world save') }
        },
        fail: () => {}
      })
    } catch (err) { console.warn('Storage not available') }
  },
  onHide() {
    if (this.screen === 'play') this.pause()
    else this.stopClock()
  },
  onDestroy() { this.stopClock() },
  onBackPress() {
    if (this.screen === 'play') this.pause()
    else if (this.screen === 'menu') this.exitGame()
    else if (this.screen === 'help' || this.screen === 'dead') this.toMenu()
    else this.resume()
    return true
  },
  handleSwipe(e) {
    if (!e) return
    if (e.direction === 'right') {
      if (this.screen === 'play') this.pause()
      else if (this.screen === 'menu') this.exitGame()
      else if (this.screen === 'help' || this.screen === 'dead') this.toMenu()
      else this.resume()
    } else if (this.screen === 'play' && e.direction === 'up') this.north()
    else if (this.screen === 'play' && e.direction === 'down') this.south()
  },
  startSurvival() { this.newWorld('survival') },
  startCreative() { this.newWorld('creative') },
  newWorld(mode) {
    this.stopClock()
    try {
      this._game = createGame(Date.now() & 0x7fffffff, mode)
      this.syncView()
      this.screen = 'play'
      this.bootError = ''
      this.saveWorld()
      this.startClock()
    } catch (err) {
      this.stopClock()
      this._game = null
      this.screen = 'menu'
      this.bootError = 'Cannot open world'
      console.error('PocketCraft init failed', err)
    }
  },
  continueGame() {
    if (!this._cachedSave) return
    try {
      this._game = restore(this._cachedSave)
      this.syncView()
      this.screen = 'play'
      this.bootError = ''
      this.startClock()
    } catch (err) {
      this._game = null
      this.screen = 'menu'
      this.bootError = 'Cannot load save'
      console.error('PocketCraft restore failed', err)
    }
  },
  startClock() {
    this.stopClock()
    this._timer = setInterval(() => {
      if (this.screen !== 'play' || !this._game) return
      stepTime(this._game)
      // Minimize image-tree redraws, refresh dynamic HUD every tick.
      if (this._game.tickNo % 4 === 0) this.syncView()
      else {
        this.hp = this._game.health
        this.food = this._game.hunger
        this.message = this._game.message
        this.dayText = isNight(this._game) ? 'NIGHT' : 'DAY'
        this.skyImage = isNight(this._game) ? '/common/night_bg.png' : '/common/day_bg.png'
      }
      if (this._game.health <= 0) {
        this.stopClock()
        this.screen = 'dead'
        this.saveWorld()
      } else if (this._game.tickNo % 5 === 0) this.saveWorld()
    }, TICK_MS)
  },
  stopClock() {
    if (this._timer) { clearInterval(this._timer); this._timer = null }
  },
  saveWorld() {
    if (!this._game) return
    try {
      const data = snapshot(this._game)
      this._cachedSave = data
      this.hasSave = true
      storage.set({key:SAVE_KEY,value:data,fail:()=>{ console.warn('Save failed') }})
    } catch (err) { console.warn('Save unavailable') }
  },
  saveNow() { this.saveWorld(); this.message = 'World saved' },
  syncView() {
    const s = this._game
    if (!s) return
    const scene = renderTiles(s)
    this.blocks = scene.blocks
    this.mobs = scene.mobs
    this.playerY = scene.playerY
    this.targetX = scene.targetX
    this.targetY = scene.targetY
    this.hp = s.health
    this.food = s.hunger
    this.dayText = isNight(s) ? 'NIGHT' : 'DAY'
    this.skyImage = isNight(s) ? '/common/night_bg.png' : '/common/day_bg.png'
    this.coordText = 'X '+s.x+'  Y '+s.y
    this.biomeText = scene.biome.toUpperCase()
    this.message = s.message
    this.selectedName = s.selected.toUpperCase()
    this.selectedCount = s.mode === 'creative' ? '∞' : String(s.inv[s.selected]||0)
    this.editsCount = Object.keys(s.edits).length
    this.inventoryRows = Object.keys(s.inv).map(k=>({
      id:k,name:k.toUpperCase(),
      count:s.mode==='creative'?'∞':String(s.inv[k]||0)
    }))
    this.recipeRows = RECIPES.map(r=>({
      id:r.id,title:r.title,
      cost:Object.keys(r.needs).map(k=>r.needs[k]+' '+k.toUpperCase()).join(' + ')
    }))
  },
  move(dir) {
    if (this.screen !== 'play' || !this._game) return
    walk(this._game,dir)
    this.syncView()
    this.saveWorld()
  },
  north() { this.move(0) },
  east() { this.move(1) },
  south() { this.move(2) },
  west() { this.move(3) },
  dig() {
    if (!this._game) return
    mine(this._game); this.syncView(); this.saveWorld()
  },
  build() {
    if (!this._game) return
    place(this._game,this._game.selected); this.syncView(); this.saveWorld()
  },
  hit() {
    if (!this._game) return
    attack(this._game); this.syncView(); this.saveWorld()
  },
  cycleBlock() {
    if (!this._game) return
    const i=HOTBAR.indexOf(this._game.selected)
    this._game.selected=HOTBAR[(i+1)%HOTBAR.length]
    this.syncView()
  },
  selectMaterial(id) {
    if (HOTBAR.indexOf(id) >= 0) {
      this._game.selected = id
      this._game.message = 'Selected '+id.toUpperCase()
      this.resume()
    } else {
      this._game.message = 'Not a building block'
      this.syncView()
    }
  },
  make(id) {
    if (!this._game) return
    craft(this._game,id)
    this.syncView()
    this.saveWorld()
  },
  eatFood() {
    if (!this._game) return
    eat(this._game);this.syncView();this.saveWorld()
  },
  openCraft() { if (this._game) { this.stopClock(); this.syncView(); this.screen='craft' } },
  openBag() { if (this._game) { this.stopClock(); this.syncView(); this.screen='bag' } },
  openHelp() { this.screen='help' },
  pause() { if (this._game) { this.stopClock(); this.saveWorld(); this.screen='pause' } },
  resume() {
    if (!this._game) { this.toMenu();return }
    this.screen='play';this.syncView();this.startClock()
  },
  respawn() {
    if (!this._game)return
    this._game.x=0;this._game.y=0;this._game.health=10
    this._game.hunger=8;this._game.time=30;this._game.enemies=[]
    this._game.message='Back to adventure!'
    this.saveWorld();this.resume()
  },
  toMenu() { this.stopClock();this.saveWorld();this.screen='menu' },
  exitGame() {
    this.stopClock();this.saveWorld();app.terminate()
  }
}
</script>

<style>
.screen { width:336px; height:480px; background-color:#183350; overflow:hidden; }
.sky { position:absolute; left:0px; top:59px; width:336px; height:287px; }
