.dpad { position:absolute; top:356px; left:7px; width:157px; height:120px; }
.dkey { position:absolute; background-color:#386481; border:2px solid #9cc9d1; border-radius:13px; width:48px; height:38px; align-items:center; justify-content:center; }
.dkey-text { color:#ffffff; font-size:24px; font-weight:bold; }
.up { left:55px; top:0px; }
