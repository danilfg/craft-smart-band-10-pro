.exit-mini { position:absolute; top:67px; right:8px; width:77px; height:30px; background-color:#9b3d45; border:2px solid #ffc4c4; border-radius:9px; align-items:center; justify-content:center; }
.exit-mini-label { color:#ffffff; font-size:15px; font-weight:bold; }
.boot-error { color:#ffb8b8; font-size:12px; text-align:center; }
.hotbar { position:absolute; top:310px; left:11px; width:314px; height:40px; background-color:#263f56; border:2px solid #8dbeaa; border-radius:12px; flex-direction:row; align-items:center; justify-content:space-around; }
.hotbar-title { color:#fbf3cb; font-size:17px; font-weight:bold; }
